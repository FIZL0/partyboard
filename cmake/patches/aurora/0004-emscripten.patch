--- a/cmake/AuroraDawnProvider.cmake
+++ b/cmake/AuroraDawnProvider.cmake
@@ -84,6 +84,23 @@
   set(_has_dawn_package TRUE)
 endif ()
 
+# Emscripten: the browser's WebGPU through emdawnwebgpu (Dawn's webgpu.h/webgpu_cpp.h on top of navigator.gpu),
+# an emcc port (--use-port=emdawnwebgpu), so no Dawn build or package.
+if (EMSCRIPTEN AND NOT TARGET dawn::webgpu_dawn)
+  message(STATUS "aurora: Using emdawnwebgpu (Emscripten)")
+  add_library(aurora_emdawnwebgpu INTERFACE)
+  target_compile_options(aurora_emdawnwebgpu INTERFACE "--use-port=emdawnwebgpu")
+  target_link_options(aurora_emdawnwebgpu INTERFACE "--use-port=emdawnwebgpu")
+  # Dawn's native tree has <dawn/webgpu_cpp.h>; the port only <webgpu/webgpu_cpp.h>.
+  set(_aurora_emdawn_compat "${CMAKE_BINARY_DIR}/aurora-emdawnwebgpu-compat")
+  file(WRITE "${_aurora_emdawn_compat}/dawn/webgpu_cpp.h" "#pragma once\n#include <webgpu/webgpu_cpp.h>\n")
+  target_include_directories(aurora_emdawnwebgpu INTERFACE "${_aurora_emdawn_compat}")
+  add_library(dawn::webgpu_dawn ALIAS aurora_emdawnwebgpu)
+  add_library(dawn::dawncpp_headers ALIAS aurora_emdawnwebgpu)
+  set(AURORA_DAWN_IS_SHARED FALSE PARENT_SCOPE)
+  return()
+endif ()
+
 # ── Auto: resolve provider based on platform availability ──
 set(_aurora_dawn_provider "${AURORA_DAWN_PROVIDER}")
 if (_aurora_dawn_provider STREQUAL "auto")
