+#ifdef AURORA_ENABLE_GX
+// The device was lost (driver reset, GPU fault, aurora_force_device_loss): every GPU object goes and is made again on
+// a new device. Between frames, on the game thread (aurora_update). The game's state (the GX state it set, RmlUi's
+// documents) stays; what only the GPU held (EFB copies, the last frame) is gone, so a frame may miss a copy.
+void recover_device() noexcept {
+  static uint64_t s_windowStart = 0;
+  static uint32_t s_windowLosses = 0;
+  const uint64_t now = SDL_GetTicks();
+  if (s_windowLosses == 0 || now - s_windowStart > 10000) {
+    s_windowStart = now;
+    s_windowLosses = 0;
+  }
+  ASSERT(++s_windowLosses <= 3, "Device lost {} times in 10 s: giving up", s_windowLosses);
+  Log.warn("Recreating the GPU device after a device loss");
+  gfx::shutdown_for_device_loss();
+#ifdef AURORA_ENABLE_RMLUI
+  rmlui::release_device_objects();
+#endif
+  imgui::release_device_objects();
+  webgpu::release_device();
+  ASSERT(webgpu::initialize(g_config.desiredBackend, g_config.allowCpuAdapter),
+         "Failed to make a new GPU device after a device loss");
+  gfx::initialize();
+  imgui::create_device_objects();
+#ifdef AURORA_ENABLE_RMLUI
+  rmlui::create_device_objects();
+#endif
+  Log.info("GPU device recreated");
+}
+#endif
+
