+#ifdef __EMSCRIPTEN__
+static bool is_ident_char(char c) noexcept { return std::isalnum(static_cast<unsigned char>(c)) || c == '_'; }
+
+// Replaces `from` with `to` where `from` doesn't continue an identifier (`fetch_u8_1(` is not `raw_fetch_u8_1(`).
+static void replace_word(std::string& s, std::string_view from, std::string_view to) {
+  for (size_t at = s.find(from); at != std::string::npos; at = s.find(from, at)) {
+    if (at > 0 && is_ident_char(s[at - 1])) {
+      at += from.size();
+      continue;
+    }
+    s.replace(at, from.size(), to);
+    at += to.size();
+  }
+}
+
+// Firefox's WGSL compiler (naga) has no unrestricted_pointer_parameters, so a function can't take a
+// ptr<storage, ...>. Each helper `fn f(p: ptr<storage, array<u32>>, ...)` becomes `f__vbuf(...)` and `f__abuf(...)`
+// on the global buffer, and every `f(&vbuf, ...)` / `f(&abuf, ...)` calls its copy.
+static std::string without_storage_ptr_params(std::string src) {
+  constexpr std::string_view param = "(p: ptr<storage, array<u32>>, ";
+  constexpr std::array bufs{"vbuf"sv, "abuf"sv};
+  std::vector<std::string> names;
+  for (size_t at = src.find(param); at != std::string::npos; at = src.find(param, at)) {
+    const size_t fn = src.rfind("fn ", at);
+    const size_t open = src.find('{', at);
+    size_t close = open;
+    for (int depth = 0; close < src.size(); ++close) {
+      depth += src[close] == '{' ? 1 : src[close] == '}' ? -1 : 0;
+      if (depth == 0) {
+        break;
+      }
+    }
+    if (fn == std::string::npos || open == std::string::npos || close >= src.size()) {
+      break;
+    }
+    const std::string name = src.substr(fn + 3, at - fn - 3);
+    const std::string body = src.substr(at + param.size(), close + 1 - at - param.size());
+    std::string copies;
+    for (const auto buf : bufs) {
+      std::string copy = body;
+      replace_word(copy, "arrayLength(p)", fmt::format("arrayLength(&{})", buf));
+      replace_word(copy, "p[", fmt::format("{}[", buf));
+      // calls of other helpers, renamed below with the call sites
+      for (size_t c = copy.find("(p, "); c != std::string::npos; c = copy.find("(p, ", c)) {
+        copy.replace(c, 4, fmt::format("(&{}, ", buf));
+      }
+      copies += fmt::format("fn {}__{}({}\n\n", name, buf, copy);
+    }
+    src.replace(fn, close + 1 - fn, copies);
+    at = fn + copies.size();
+    names.push_back(name);
+  }
+  for (const auto& name : names) {
+    for (const auto buf : bufs) {
+      replace_word(src, fmt::format("{}(&{}, ", name, buf), fmt::format("{}__{}(", name, buf));
+    }
+  }
+  return src;
+}
+#endif
+
 wgpu::ShaderModule build_shader(const ShaderConfig& config) noexcept {
   ZoneScoped;
+#ifdef __EMSCRIPTEN__
+  const auto shaderSource = without_storage_ptr_params(build_shader_source(config));
+#else
   const auto shaderSource = build_shader_source(config);
+#endif
   const auto hash = xxh3_hash(config);
   wgpu::ShaderSourceWGSL wgslDescriptor{};
   wgslDescriptor.code = shaderSource.c_str();
