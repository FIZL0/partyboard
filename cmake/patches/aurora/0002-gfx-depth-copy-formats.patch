+// GX_TF_Z24X8: 24-bit depth -> RGBA8 (R = bits 23:16, G = 15:8, B = 7:0, X = 1.0)
+static constexpr std::string_view FragZ24X8 = R"(
+@fragment fn fs_main(in: VertexOutput) -> @location(0) vec4f {
+    let z = gx_z24(in.uv);
+    let r = f32((z >> 16u) & 0xFFu) / 255.0;
+    let g = f32((z >> 8u) & 0xFFu) / 255.0;
+    let b = f32(z & 0xFFu) / 255.0;
+    return vec4f(r, g, b, 1.0);
+}
+)"sv;
+
+// GX_TF_Z8: Upper 8-bits depth -> I8
+static constexpr std::string_view FragZ8 = R"(
+@fragment fn fs_main(in: VertexOutput) -> @location(0) vec4f {
+    let i = f32((gx_z24(in.uv) >> 16u) & 0xFFu) / 255.0;
+    return vec4f(i, i, i, i);
+}
+)"sv;
+
+// GX_CTF_Z4: Upper 4-bits depth -> I4
+static constexpr std::string_view FragZ4 = R"(
