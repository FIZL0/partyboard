+}
+)"sv;
+
+// GX_CTF_Z8M: Middle 8-bits depth -> I8
+static constexpr std::string_view FragZ8M = R"(
+@fragment fn fs_main(in: VertexOutput) -> @location(0) vec4f {
+    let i = f32((gx_z24(in.uv) >> 8u) & 0xFFu) / 255.0;
+    return vec4f(i, i, i, i);
+}
+)"sv;
+
+// GX_CTF_Z8L: Lower 8-bits depth -> I8
+static constexpr std::string_view FragZ8L = R"(
+@fragment fn fs_main(in: VertexOutput) -> @location(0) vec4f {
+    let i = f32(gx_z24(in.uv) & 0xFFu) / 255.0;
+    return vec4f(i, i, i, i);
+}
+)"sv;
+
+// GX_CTF_Z16L: Lower 16-bits depth -> IA8
+static constexpr std::string_view FragZ16L = R"(
