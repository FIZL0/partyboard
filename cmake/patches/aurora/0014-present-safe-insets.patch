+void set_present_insets(float left, float top, float right, float bottom) {
+  const auto clampShare = [](float v) { return std::isfinite(v) ? std::clamp(v, 0.f, 0.45f) : 0.f; };
+  const std::array<float, 4> insets{clampShare(left), clampShare(top), clampShare(right), clampShare(bottom)};
+  if (insets == g_presentInsets) {
+    return;
+  }
+  g_presentInsets = insets;
+  Log.info("Present insets {} {} {} {}", insets[0], insets[1], insets[2], insets[3]);
+  request_frame_buffer_resize();
+}
+
+std::array<float, 4> present_insets() noexcept { return g_presentInsets; }
+
+PresentRect present_rect(uint32_t width, uint32_t height) noexcept {
+  const auto [l, t, r, b] = g_presentInsets;
+  const auto x0 = static_cast<uint32_t>(std::lround(static_cast<float>(width) * l));
+  const auto y0 = static_cast<uint32_t>(std::lround(static_cast<float>(height) * t));
+  const auto x1 = static_cast<uint32_t>(std::lround(static_cast<float>(width) * (1.f - r)));
+  const auto y1 = static_cast<uint32_t>(std::lround(static_cast<float>(height) * (1.f - b)));
+  if (x1 <= x0 || y1 <= y0) {
+    return {0, 0, std::max(width, 1u), std::max(height, 1u)};
+  }
+  return {x0, y0, x1 - x0, y1 - y0};
+}
+
 void set_background_input(bool value) { SDL_SetHint(SDL_HINT_JOYSTICK_ALLOW_BACKGROUND_EVENTS, value ? "1" : "0"); }
 
