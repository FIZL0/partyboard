+
+// Saves the frame as shown, the game's image with RmlUi drawn over it (not ImGui), to a PNG at `path`, at the size
+// RmlUi renders (the window's). delay_frames counts the frames RmlUi draws something from now (0 = the next one); a
+// frame where RmlUi draws nothing is not captured. The file is written when the GPU readback completes.
+void aurora_capture_frame_ui(const char* path, uint32_t delay_frames);
+
+#ifdef __cplusplus
+}
+#endif
