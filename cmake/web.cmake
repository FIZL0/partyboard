# N87: browser build (Emscripten), after the dol and REL targets exist. cmake/web_early.cmake set them up as a static
# library and object libraries; tools/web.sh configures (preset `web`), builds and puts the page together.
#
# RELs: on the desktop each is a .so exporting only ObjectSetup, loaded with dlopen. Here each REL's objects are
# prelinked into one (emcc -r), then tools/web_rel_localize.py makes every symbol it defines local but its
# ObjectSetup (compiled as ObjectSetup_<rel>), so the RELs' shared names (lbl_1_data_0, ...) don't clash, and puts
# its .data/.bss in one data segment pbrel_<rel>. web_rel_table.c lists them for src/port/web/web_rel.c, which
# gives a REL its boot-time data back each time it is linked again, as a fresh dlopen does.

find_package(Python3 REQUIRED COMPONENTS Interpreter)

# libco has no wasm backend: Emscripten fibers (Asyncify) instead.
set_source_files_properties(${CMAKE_SOURCE_DIR}/extern/libco/libco.c PROPERTIES HEADER_FILE_ONLY ON)
target_sources(dol PRIVATE ${CMAKE_SOURCE_DIR}/src/port/web/libco_emscripten.c)
# N92: the page's clipboard (SDL has none on Emscripten): online codes are copied both ways.
target_sources(dol PRIVATE ${CMAKE_SOURCE_DIR}/src/port/web/web_clipboard.c)
# N98: the menu's focus for page scripts that press its buttons (tools/web_pair.mjs).
target_sources(dol PRIVATE ${CMAKE_SOURCE_DIR}/src/port/web/web_ui_probe.cpp)

# The C/C++ is built without exception handling (Asyncify can't unwind through a function that has any), but these
# catch what libc++/nlohmann throw (a config file that isn't there yet, ...). None of their functions is on the
# stack when the game yields; tools/web_eh_list.py keeps Asyncify off them.
set_source_files_properties(${CMAKE_SOURCE_DIR}/src/port/config.cpp ${CMAKE_SOURCE_DIR}/src/port/achievements.cpp
        ${CMAKE_SOURCE_DIR}/src/port/ui/prelaunch.cpp TARGET_DIRECTORY dol PROPERTIES COMPILE_OPTIONS -fwasm-exceptions)

set(PB_WEB_REL_DIR ${CMAKE_BINARY_DIR}/web-rel)
set(PB_WEB_REL_OBJECTS "")
set(PB_WEB_REL_DECLS "")
set(PB_WEB_REL_ENTRIES "")
foreach (rel ${REL_TARGETS})
    if (NOT TARGET ${rel})
        continue()
    endif ()
    target_compile_definitions(${rel} PRIVATE ObjectSetup=ObjectSetup_${rel})
    set(prelinked ${PB_WEB_REL_DIR}/${rel}.r.o)
    set(localized ${PB_WEB_REL_DIR}/${rel}.o)
    add_custom_command(OUTPUT ${localized}
            COMMAND ${CMAKE_COMMAND} -E make_directory ${PB_WEB_REL_DIR}
            COMMAND ${CMAKE_C_COMPILER} -r $<TARGET_OBJECTS:${rel}> -o ${prelinked}
            COMMAND ${Python3_EXECUTABLE} ${CMAKE_SOURCE_DIR}/tools/web_rel_localize.py ${prelinked} ${localized}
                    pbrel_${rel} ObjectSetup_${rel}
            DEPENDS ${rel} $<TARGET_OBJECTS:${rel}> ${CMAKE_SOURCE_DIR}/tools/web_rel_localize.py
            COMMAND_EXPAND_LISTS
            COMMENT "Prelinking REL ${rel} for the web build"
            VERBATIM)
    list(APPEND PB_WEB_REL_OBJECTS ${localized})
    string(APPEND PB_WEB_REL_DECLS "void ObjectSetup_${rel}(void);\n"
            "extern char __start_pbrel_${rel}[] __attribute__((weak));\n"
            "extern char __stop_pbrel_${rel}[] __attribute__((weak));\n")
    string(APPEND PB_WEB_REL_ENTRIES "    { \"${rel}\", ObjectSetup_${rel}, __start_pbrel_${rel}, __stop_pbrel_${rel} },\n")
endforeach ()
list(LENGTH PB_WEB_REL_OBJECTS PB_WEB_REL_COUNT)
file(CONFIGURE OUTPUT ${CMAKE_BINARY_DIR}/web_rel_table.c CONTENT "/* Generated by cmake/web.cmake. */
typedef struct WebRel {
    const char *name;
    void (*setup)(void);
    char *start;
    char *stop;
} WebRel;
@PB_WEB_REL_DECLS@
const WebRel web_rel_table[] = {
@PB_WEB_REL_ENTRIES@};
const int web_rel_count = @PB_WEB_REL_COUNT@;
" @ONLY)
set_source_files_properties(${PB_WEB_REL_OBJECTS} PROPERTIES EXTERNAL_OBJECT TRUE GENERATED TRUE)

# Object libraries can't be installed like the .so files.
list(REMOVE_ITEM BINARY_TARGETS ${REL_TARGETS})

# aurora's nod (a Rust staticlib) is linked as is. Its Rust std's compiler_builtins (fmodf, __multf3, ...) has wasm
# exception handling in it and may stand in for libc's; they are leaves, and tools/web_eh_list.py keeps Asyncify off
# them. Hiding them as cmake/pbnet.cmake does on the desktop (prelink, make all but nod_* local) gave wasm-ld an
# invalid module (nod's bundled zlib-ng, local, next to the C build's, global), see the N87 journal.

set(PB_WEB_DEBUG OFF CACHE BOOL "Web build: Emscripten runtime assertions and a debuggable wasm")

# The link options partyboard and its probe (below) share.
function(pb_web_link target)
    target_sources(${target} PRIVATE ${PB_WEB_REL_OBJECTS} ${CMAKE_BINARY_DIR}/web_rel_table.c
            ${CMAKE_SOURCE_DIR}/src/port/web/web_rel.c)
    target_include_directories(${target} PRIVATE ${CMAKE_SOURCE_DIR}/include)
    target_link_options(${target} PRIVATE
            # Rust's std for wasm32-unknown-emscripten (nod) uses wasm exceptions, which need their tag. The C/C++
            # is not compiled with them; see tools/web_eh_list.py for Asyncify.
            -fwasm-exceptions
            -sALLOW_MEMORY_GROWTH=1
            -sINITIAL_MEMORY=268435456
            -sMAXIMUM_MEMORY=4294967296
            -sSTACK_SIZE=8388608
            -sENVIRONMENT=web
            -sMODULARIZE=1
            -sEXPORT_NAME=createPartyBoard
            -sFORCE_FILESYSTEM=1
            -sEXPORTED_RUNTIME_METHODS=FS,ENV,IDBFS,callMain,addRunDependency,removeRunDependency,UTF8ToString,stringToNewUTF8
            # The user dir (/libsdl: config, memory card) is kept in IndexedDB by the page.
            -lidbfs.js
            -sEXIT_RUNTIME=0)
    # N92: pbnet's WebRTC in the page (net/src/rtc.rs); the C stub has no imports.
    if (NOT PBNET_STUB)
        target_link_options(${target} PRIVATE "--js-library=${CMAKE_SOURCE_DIR}/src/port/web/pbnet_rtc.js")
        set_property(TARGET ${target} APPEND PROPERTY LINK_DEPENDS ${CMAKE_SOURCE_DIR}/src/port/web/pbnet_rtc.js)
        # The lobby's C ABI for the page's scripts (tools/web_pair.mjs drives two tabs' lobbies with it).
        target_link_options(${target} PRIVATE
                "-sEXPORTED_FUNCTIONS=_main,_malloc,_free,_pbnet_lobby_host,_pbnet_lobby_join,_pbnet_lobby_answer,_pbnet_lobby_json,_pbnet_lobby_ready,_pbnet_lobby_start,_pbnet_lobby_leave,_pbnet_lobby_cpu,_pbnet_frame,_pbnet_waiting_on,_pbnet_recover_json,_pb_web_ui_focus")
    endif ()
endfunction()

# Probe: partyboard linked without Asyncify and with its names, to list the functions that use wasm exceptions
# (Asyncify's pass breaks on them; none ever yields).
add_executable(partyboard_eh_probe EXCLUDE_FROM_ALL src/port/entry.cpp)
target_compile_definitions(partyboard_eh_probe PRIVATE TARGET_PC NON_MATCHING VERSION=${VERSION})
target_include_directories(partyboard_eh_probe PRIVATE include ${CMAKE_BINARY_DIR})
target_link_libraries(partyboard_eh_probe PRIVATE dol aurora::main)
pb_web_link(partyboard_eh_probe)
# -O1 as partyboard (same functions; wasm-dis cannot read an -O0 link).
target_link_options(partyboard_eh_probe PRIVATE -O1 --profiling-funcs -sASYNCIFY=0)
# Emscripten's own binaryen (next to emcc), not a system one of another version.
get_filename_component(PB_EMSCRIPTEN_DIR ${CMAKE_C_COMPILER} DIRECTORY)
find_program(PB_WASM_DIS wasm-dis PATHS ${PB_EMSCRIPTEN_DIR}/../bin NO_DEFAULT_PATH REQUIRED)
# The list is too long for one argument (wasm-opt gets it as one), so emcc's response file names another file that
# binaryen reads itself: emcc turns . # ? in it into space & , so its path can't have them.
set(PB_WEB_EH_LIST ${CMAKE_BINARY_DIR}/web_asyncify_remove)
if (PB_WEB_EH_LIST MATCHES "[.#?]")
    message(FATAL_ERROR "web: the build dir's path can't have . # or ? in it (${PB_WEB_EH_LIST}), see cmake/web.cmake")
endif ()
file(WRITE ${CMAKE_BINARY_DIR}/web_asyncify_remove.rsp "@${PB_WEB_EH_LIST}\n")
add_custom_command(OUTPUT ${PB_WEB_EH_LIST}
        COMMAND sh -c "set -o pipefail; '${PB_WASM_DIS}' '$<TARGET_FILE_DIR:partyboard_eh_probe>/partyboard_eh_probe.wasm' | '${Python3_EXECUTABLE}' '${CMAKE_SOURCE_DIR}/tools/web_eh_list.py' '${PB_WEB_EH_LIST}'"
        DEPENDS partyboard_eh_probe ${CMAKE_SOURCE_DIR}/tools/web_eh_list.py
        COMMENT "Listing the functions Asyncify must skip (web)"
        VERBATIM)
add_custom_target(web_asyncify_list DEPENDS ${PB_WEB_EH_LIST})
add_dependencies(partyboard web_asyncify_list)

pb_web_link(partyboard)
set_property(TARGET partyboard APPEND PROPERTY LINK_DEPENDS ${PB_WEB_EH_LIST})
target_link_options(partyboard PRIVATE
        # Fibers (libco) and the per-frame yield to the browser unwind the wasm stack.
        -sASYNCIFY=1
        -sASYNCIFY_STACK_SIZE=1048576
        "-sASYNCIFY_REMOVE=@${CMAKE_BINARY_DIR}/web_asyncify_remove.rsp"
        # wasm-opt -O2 and up inline before Asyncify runs, which could put a removed function's exception handling
        # into one Asyncify instruments; tools/web.sh optimizes the result afterwards.
        -O1
        # Function names in the wasm: readable stacks in the browser's console and debugger.
        --profiling-funcs
        # The game's resources (fonts, RmlUi documents); the disc is the player's, picked in the page.
        --preload-file ${CMAKE_SOURCE_DIR}/res@/res)
if (PB_WEB_DEBUG)
    target_link_options(partyboard PRIVATE -sASSERTIONS=2 -sSTACK_OVERFLOW_CHECK=2 -g2)
else ()
    target_link_options(partyboard PRIVATE -sASSERTIONS=0)
endif ()
