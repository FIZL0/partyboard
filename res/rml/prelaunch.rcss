/* N141: the Party Board home screen. One flex layout (no absolutely placed text), inside the safe area (#root's
   padding, Prelaunch::update): desktop and landscape tablets put the logo over a column of big buttons on the left;
   landscape phones (max-height 640dp) put the logo on the left and the buttons on the right; portrait stacks
   everything in the middle. Behind it the disc's title backdrop drifts slowly (#art, home_art.cpp), or, without a disc,
   the menu's own picture drifts (.plain). */

*, *:before, *:after {
    box-sizing: border-box;
}

body {
    width: 100%;
    height: 100%;
    font-family: "N64 Party";
    font-weight: normal;
    font-size: 20dp;
    color: #FFFFFF;
    background-color: #1d1035;
    filter: opacity(0);
    transition: filter 1s 0.2s linear-in-out;
    z-index: -1;
    overflow: hidden;
}

body[open] {
    filter: opacity(1);
}

/* Backdrops */
@keyframes home-drift {
    from { transform: scale(1.0) translateX(0dp); }
    to { transform: scale(1.08) translateX(-24dp); }
}

/* the burst slowly comes closer, turning a little */
@keyframes home-burst {
    from { transform: scale(1.05) rotate(-3deg); }
    to { transform: scale(1.25) rotate(3deg); }
}

@keyframes home-pulse {
    from { opacity: 0.55; }
    to { opacity: 0.8; }
}

.plain {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    decorator: image(../prelaunch-bg.png cover right center);
    animation: 30s cubic-in-out infinite alternate home-drift;
}

#art {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    /* scaled 1.05 and more, so the edges stay out of sight as it turns */
    animation: 40s sine-in-out infinite alternate home-burst;
}

body.has-art #art {
    display: block;
}

body.has-art .plain {
    display: none;
}

/* a soft light in the middle of the burst, breathing */
.glow {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    decorator: radial-gradient(circle farthest-side at 60% 50%, #FFFFFF22, #FFFFFF00 60%);
    animation: 6s sine-in-out infinite alternate home-pulse;
}

body.has-art .glow {
    display: block;
}

/* darkens the side the menu is on, so the buttons read over any part of the picture */
.shade {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    decorator: horizontal-gradient(#0b0518E6 #0b051800);
}

/* Layout */
content {
    display: flex;
    flex-direction: column;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    padding: 32dp 48dp;
    filter: opacity(0);
    transition: filter 0.2s linear-in-out;
}

content[open] {
    filter: opacity(1);
}

menu {
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    justify-content: center;
    align-items: stretch;
    gap: 32dp;
    width: 36vw;
    min-width: 380dp;
    max-width: 560dp;
    min-height: 0;
}

hero {
    display: block;
    flex: 0 0 auto;
}

hero img {
    width: 100%;
    height: auto;
}

.eyebrow {
    margin-bottom: 8dp;
    font-size: 22dp;
    font-effect: shadow(0dp 2dp #00000080);
}

.eyebrow span {
    font-weight: bold;
}

#menu-list {
    display: flex;
    flex: 0 1 auto;
    flex-direction: column;
    gap: 12dp;
    min-height: 0;
    overflow-y: auto;
    padding: 4dp;
}

/* Thumb-sized buttons: 64dp tall (48dp at least on small phones), the whole row is the target. */
#menu-list button {
    display: block;
    flex: 0 0 auto;
    width: 100%;
    min-height: 64dp;
    padding: 14dp 24dp;
    border-radius: 16dp;
    border-width: 2dp;
    border-color: #FFFFFF26;
    background-color: #0b0518A6;
    text-align: left;
    text-transform: uppercase;
    font-size: 32dp;
    font-weight: normal;
    font-effect: shadow(0dp 2dp #00000080);
    cursor: pointer;
}

#menu-list button.anim-done {
    transition: background-color border-color color transform 0.12s cubic-out;
}

#menu-list button:hover,
#menu-list button:focus-visible {
    color: #0b0518;
    background-color: #009ddaF2;
    border-color: #FFFFFFE6;
    font-effect: none;
    transform: scale(1.02);
}

#menu-list button:active {
    background-color: #33b5e8;
    transform: scale(0.98);
}

#menu-list button:disabled {
    opacity: 0.6;
    cursor: default;
}

/* N132: Continue buttons carry their game (board, turn, players) under the label. */
#menu-list button.continue {
    background-color: #2a1460C0;
    border-color: #ffd23f80;
}

#menu-list button.continue .continue-detail {
    display: block;
    margin-top: 2dp;
    font-size: 16dp;
    text-transform: none;
    opacity: 0.85;
}

/* Status: the disc on the left, the version on the right, each a small pill */
footer {
    display: flex;
    flex: 0 0 auto;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16dp;
    font-size: 18dp;
}

disc-info,
version-info {
    display: flex;
    flex-direction: column;
    gap: 4dp;
    padding: 8dp 14dp;
    border-radius: 12dp;
    background-color: #0b0518A6;
}

version-info {
    text-align: right;
}

#disc-status {
    display: flex;
    align-items: center;
    gap: 8dp;
}

#disc-status[status=good] {
    color: #D8F999;
}

#disc-status[status=bad] {
    color: #FFC9C9;
}

#disc-status[status=verifying] {
    color: #FFFFFF;
}

#disc-status[status=mismatch] {
    color: #FFD6A7;
}

#disc-status[status=unknown] {
    color: rgba(224, 219, 200, 65%);
}

#disc-status[status=pending] {
    color: #009dda;
}

#disc-status icon {
    display: none;
    width: 22dp;
    height: 22dp;
    font-family: "Material Symbols Rounded";
    font-weight: normal;
    font-size: 22dp;
}

#disc-status[status] icon {
    display: block;
}

#disc-status[status=good] icon {
    decorator: text("&#xe5ca;" center center);
}

#disc-status[status=bad] icon {
    decorator: text("&#xe5cd;" center center);
}

#disc-status[status=verifying] icon {
    decorator: text("&#xe8b5;" center center);
}

#disc-status[status=mismatch] icon {
    decorator: text("&#xe002;" center center);
}

#disc-status[status=unknown] icon {
    decorator: text("&#xe887;" center center);
}

#disc-status[status=pending] icon {
    decorator: text("&#xe863;" center center);
}

#disc-version {
    font-size: 16dp;
}

.detail {
    color: #C9C2D6;
}

#crash-note {
    max-width: 640dp;
    font-size: 16dp;
    word-break: break-word;
}

/* Startup animation */
.intro-item {
    opacity: 0;
    transform: translateY(10dp);
    transition: opacity transform 0.3s 0.1s cubic-in-out;
}

body.animate-in .intro-item {
    opacity: 1;
    transform: translateY(0dp);
}

.delay-0 {
    transition: opacity transform 0.3s 0.1s cubic-in-out;
}

.delay-1 {
    transition: opacity transform 0.3s 0.2s cubic-in-out;
}

.delay-2 {
    transition: opacity transform 0.3s 0.3s cubic-in-out;
}

.delay-3 {
    transition: opacity transform 0.3s 0.4s cubic-in-out;
}

.delay-4 {
    transition: opacity transform 0.3s 0.5s cubic-in-out;
}

.delay-5 {
    transition: opacity transform 0.3s 0.6s cubic-in-out;
}

.delay-6 {
    transition: opacity transform 0.3s 0.7s cubic-in-out;
}

/* N131: Settings > Gameplay > Fast Menus: short fades, the entrance without its stagger */
body.fast {
    transition: filter 0.25s linear-in-out;
}

body.fast .intro-item {
    transition: opacity transform 0.15s 0s cubic-in-out;
}

/* Landscape phones: the logo on the left, the buttons on the right (they scroll if Continue makes them too many). */
@media (max-height: 640dp) and (orientation: landscape) {
    content {
        padding: 16dp 24dp;
    }

    .shade {
        decorator: horizontal-gradient(#0b051880 #0b0518E6);
    }

    menu {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        gap: 24dp;
        width: 100%;
        min-width: 0;
        max-width: none;
    }

    hero {
        flex: 1 1 0;
        max-width: 46%;
    }

    #menu-list {
        flex: 1 1 0;
        max-width: 50%;
        max-height: 100%;
        gap: 8dp;
    }

    #menu-list button {
        min-height: 52dp;
        padding: 11dp 20dp;
        font-size: 26dp;
    }

    #menu-list button.continue .continue-detail {
        font-size: 14dp;
    }

    footer {
        font-size: 15dp;
    }

    #disc-version,
    #crash-note {
        font-size: 13dp;
    }

    .eyebrow {
        display: none;
    }

    disc-info,
    version-info {
        padding: 4dp 10dp;
        border-radius: 10dp;
    }
}

/* Portrait: logo, buttons and status in one centred column. */
@media (orientation: portrait) {
    content {
        padding: 24dp 20dp;
    }

    .shade {
        decorator: vertical-gradient(#0b051840 #0b0518E6);
    }

    menu {
        align-self: center;
        width: 100%;
        min-width: 0;
        max-width: 520dp;
        gap: 24dp;
    }

    hero {
        padding: 0 8%;
    }

    #menu-list button {
        text-align: center;
        min-height: 60dp;
        font-size: 28dp;
    }

    footer {
        flex-direction: column;
        align-items: center;
        gap: 8dp;
        font-size: 15dp;
    }

    disc-info,
    version-info {
        align-items: center;
        text-align: center;
    }

    #disc-status {
        justify-content: center;
    }
}
