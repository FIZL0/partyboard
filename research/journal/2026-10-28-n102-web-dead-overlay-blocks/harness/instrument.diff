+
+/* N102 instrument (not committed): every used block's caller placed by caller_module. */
+typedef struct N102Census {
+    const void *owners[16];
+    s32 counts[16];
+    s32 gone, marks, dol;
+} N102Census;
+
+static BOOL n102_count(uintptr_t retaddr, void *user)
+{
+    N102Census *c = user;
+    const void *m;
+    s32 i;
+    if (retaddr == 0 || retaddr == 0xCDCDCDCD || retaddr == 0xA5A5A5A5) {
+        c->marks++;
+        return FALSE;
+    }
+    m = caller_module(retaddr);
+    if (m == NULL) {
+        c->gone++;
+        return FALSE;
+    }
+    if (m == caller_module(HU_MEM_CALLER())) {
+        c->dol++;
+        return FALSE;
+    }
+    for (i = 0; i < 16 && c->owners[i] != NULL && c->owners[i] != m; i++) {
+    }
+    if (i < 16) {
+        c->owners[i] = m;
+        c->counts[i]++;
+    }
+    return FALSE;
+}
+
+void n102_census(const char *tag)
+{
+    N102Census c;
+    s32 heap, i;
+    char line[512];
+    int n;
+    memset(&c, 0, sizeof(c));
+    for (heap = 0; heap < HEAP_MAX; heap++) {
+        if (HuMemHeapPtrGet((HeapID)heap) != NULL) {
+            HuMemMemoryFreeIf(HuMemHeapPtrGet((HeapID)heap), n102_count, &c);
+        }
+    }
+    n = snprintf(line, sizeof(line), "n102 census %s ovl %d: dol %d, gone %d, marks %d", tag, (int)omcurovl, (int)c.dol,
+        (int)c.gone, (int)c.marks);
+    for (i = 0; i < 16 && c.owners[i] != NULL && n < (int)sizeof(line); i++) {
+#if defined(__EMSCRIPTEN__)
+        n += snprintf(line + n, sizeof(line) - n, ", %s %d", *(const char *const *)c.owners[i], (int)c.counts[i]);
+#else
+        n += snprintf(line + n, sizeof(line) - n, ", %p %d", c.owners[i], (int)c.counts[i]);
+#endif
+    }
+    OSReport("%s\n", line);
+}
