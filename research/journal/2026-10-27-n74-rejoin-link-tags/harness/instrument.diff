diff --git i/src/port/netplay_match.c w/src/port/netplay_match.c
index 4c4a06d1..5e3de756 100644
--- i/src/port/netplay_match.c
+++ w/src/port/netplay_match.c
@@ -961,3 +961,43 @@ BOOL netplay_match_parse_debug(const char *spec, NetplayMatch *m, u32 *at_frame)
     *at_frame = (u32)at;
     return TRUE;
 }
+
+/* N74 TEMP: every heap alloc/free while a match runs, with the caller chain */
+#include <dlfcn.h>
+#include <execinfo.h>
+#include <stdlib.h>
+void n74_mem(int kind, void *data, s32 size, uintptr_t num)
+{
+    static FILE *f;
+    static int on = -1;
+    static int busy;
+    void *bt[12];
+    int n, k, heap;
+    uintptr_t off = (uintptr_t)-1;
+    if (on < 0) {
+        const char *e = getenv("N74_LOG");
+        on = e != NULL;
+        if (on) f = fopen(e, "w");
+    }
+    if (!on || f == NULL || busy || !netplay_match_running()) return;
+    busy = 1;
+    for (heap = 0; heap < HEAP_MAX; heap++) {
+        uintptr_t base = (uintptr_t)HuMemHeapPtrGet((HeapID)heap);
+        if (base != 0 && (uintptr_t)data >= base && (uintptr_t)data - base < HuMemHeapSizeGet((HeapID)heap)) {
+            off = (uintptr_t)data - base;
+            break;
+        }
+    }
+    fprintf(f, "f%u ovl%d %c h%d off %lx size %x num %llx:", netplay_frame(), (int)omcurovl, "?AFE"[kind], heap,
+        (unsigned long)off, (unsigned)size, (unsigned long long)heap_num(num));
+    n = backtrace(bt, 12);
+    for (k = 2; k < n; k++) {
+        Dl_info di;
+        if (dladdr(bt[k], &di) && di.dli_fname) {
+            const char *b = strrchr(di.dli_fname, '/');
+            fprintf(f, " %s+%lx", b ? b + 1 : di.dli_fname, (unsigned long)((uintptr_t)bt[k] - (uintptr_t)di.dli_fbase));
+        }
+    }
+    fputc('\n', f);
+    busy = 0;
+}
