+/* N68 scratch: dump libdol's writable segments at an overlay start (PB_N68_DUMP=<dir>). */
+#include <link.h>
+static int n68_phdr(struct dl_phdr_info *info, size_t size, void *user)
+{
+    FILE *f = (FILE *)user;
+    int i;
+    (void)size;
+    if (info->dlpi_name == NULL || strstr(info->dlpi_name, "libdol.so") == NULL) {
+        return 0;
+    }
+    for (i = 0; i < info->dlpi_phnum; i++) {
+        const ElfW(Phdr) *ph = &info->dlpi_phdr[i];
+        if (ph->p_type == PT_LOAD && (ph->p_flags & PF_W)) {
+            unsigned long long v = ph->p_vaddr, n = ph->p_memsz, base = info->dlpi_addr;
+            fwrite(&base, 8, 1, f);
+            fwrite(&v, 8, 1, f);
+            fwrite(&n, 8, 1, f);
+            fwrite((void *)(info->dlpi_addr + ph->p_vaddr), 1, ph->p_memsz, f);
+        }
+    }
+    return 1;
+}
+
+void n68_dump(s32 ovl)
+{
+    static int seq;
+    const char *dir = getenv("PB_N68_DUMP");
+    char path[512];
+    FILE *f;
+    if (dir == NULL) {
+        return;
+    }
+    snprintf(path, sizeof(path), "%s/%02d-f%u-ovl%d.bin", dir, seq++, netplay_frame(), (int)ovl);
+    f = fopen(path, "wb");
+    if (f == NULL) {
+        return;
+    }
+    dl_iterate_phdr(n68_phdr, f);
+    fclose(f);
+}
