 void ui_update(void)
 {
+    { // N51 TEST HOOK
+        static int n = 0, joined = 0;
+        static int lastVis = -1;
+        const char *cf = getenv("N33_CODE");
+        if (cf && ++n > 300) {
+            if (!joined) {
+                std::ifstream in(cf); std::string code; std::getline(in, code);
+                if (!code.empty()) {
+                    std::string setup = std::string("{\"build\":\"") + getenv("N33_BUILD") + "\",\"disc\":\"GMPE01-01\",\"players\":[{\"name\":\"Guesty\",\"key\":\"guestykey\"}],\"relay\":\"off\"}";
+                    joined = pbnet_lobby_join(setup.c_str(), code.c_str());
+                    fprintf(stderr, "N51 join %d\n", joined);
+                }
+            } else if (pbnet_lobby_state() == PBNET_LOBBY_OPEN && n % 60 == 0) {
+                fprintf(stderr, "N51 ready %d\n", pbnet_lobby_ready(1));
+            }
+        }
+        const int vis = partyboard::ui::any_document_visible() ? 1 : 0;
+        if (vis != lastVis) {
+            fprintf(stderr, "N51 ui frame %d any_document_visible %d top %s\n", n, vis,
+                partyboard::ui::top_document() ? typeid(*partyboard::ui::top_document()).name() : "-");
+            lastVis = vis;
+        }
+        static int holdFrames = 0;
+        auto *modal = dynamic_cast<partyboard::ui::Modal *>(partyboard::ui::top_document());
+        holdFrames = modal != nullptr && modal->visible() ? holdFrames + 1 : 0;
+        if (getenv("N51_KEEP") && holdFrames == 60) {
+            fprintf(stderr, "N51 pressing Keep Waiting (dismiss)\n");
+            modal->dismiss();
+        }
+    }
     // A started online lobby's match begins here, between game ticks (src/port/netplay.c).
     netplay_lobby_poll();
     // N10: a dropped peer holds the match: "Waiting for <name>", "Host left"
