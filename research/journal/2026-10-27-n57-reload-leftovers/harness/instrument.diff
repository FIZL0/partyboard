+#define N57_SLOTS (1u << 20)
+#define N57_DEPTH 16
+static struct { void *key; void *bt[N57_DEPTH]; } *n57_tab;
+static void n57_rec(void *data)
+{
+    uintptr_t h;
+    if (n57_tab == NULL) n57_tab = calloc(N57_SLOTS, sizeof(*n57_tab));
+    h = ((uintptr_t)data >> 5) & (N57_SLOTS - 1);
+    while (n57_tab[h].key != NULL && n57_tab[h].key != data) h = (h + 1) & (N57_SLOTS - 1);
+    n57_tab[h].key = data;
+    memset(n57_tab[h].bt, 0, sizeof(n57_tab[h].bt));
+    backtrace(n57_tab[h].bt, N57_DEPTH);
+}
+void **n57_bt(void *data)
+{
+    uintptr_t h;
+    if (n57_tab == NULL) return NULL;
+    h = ((uintptr_t)data >> 5) & (N57_SLOTS - 1);
+    while (n57_tab[h].key != NULL) { if (n57_tab[h].key == data) return n57_tab[h].bt; h = (h + 1) & (N57_SLOTS - 1); }
+    return NULL;
+}
 
