+/* N75 TEMP: N75_RESTART=<ovl>:<frames>:<times> restarts that overlay that many frames in, as a reload kills it */
+#include <dlfcn.h>
+#include "game/process.h"
+#include "game/memory.h"
+#include "game/object.h"
+static BOOL n75_foreign(const Process *p, void *dol)
+{
+    Dl_info a, b;
+    const void *f = (p->func && dladdr((void *)(uintptr_t)p->func, &a)) ? a.dli_fbase : NULL;
+    const void *d = (p->dtor && dladdr((void *)(uintptr_t)p->dtor, &b)) ? b.dli_fbase : NULL;
+    return (f != NULL && f != dol) || (d != NULL && d != dol);
+}
+static void n75_restart_proc(void)
+{
+    Dl_info me;
+    dladdr((void *)(uintptr_t)netplay_tick_begin, &me);
+    OSReport("n75: restart: killed %d\n", (int)HuPrcKillIf(n75_foreign, me.dli_fbase));
+    omOvlGotoEx(omcurovl, 1, 0, 0);
+    HuPrcEnd();
+}
+static void n75_restart(void)
+{
+    static int ovl = -2, frames, times, last = -1, n, done;
+    const char *e = getenv("N75_RESTART");
+    if (e == NULL) return;
+    if (ovl == -2) sscanf(e, "%d:%d:%d", &ovl, &frames, &times);
+    if ((int)omcurovl != last) { last = omcurovl; n = 0; }
+    if ((int)omcurovl == ovl && ++n == frames && done < times) {
+        done++;
+        HuPrcCreate(n75_restart_proc, 0xFFFF, 0x2000, 0);
+    }
+}
+
 BOOL netplay_tick_begin(void)
 {
     PADStatus local[4];
